@model IEnumerable<IT_ELECTIVE_PREFINALS_PROJECT.Models.Employee>
@{
    ViewData["Title"] = "Employee Workload Analysis";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3"><h2>Employee & Department Workload</h2><a asp-action="Index" class="btn btn-secondary btn-sm">&larr; Back to Dashboard</a></div><hr /><div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark"><tr><th>Employee Name</th><th>Department</th><th>Total Assigned Tickets</th><th>Assigned Ticket IDs</th></tr></thead>
        <tbody>
            @foreach (var emp in Model)
            {
                <tr>
                    <td><strong>@emp.FirstName @emp.LastName</strong></td>
                    <td>@(emp.Department?.Name ?? "N/A")</td>
                    <td><span class="badge bg-primary fs-6">@emp.TicketAssignments.Count</span></td>
                    <td>
                        @if (emp.TicketAssignments.Any())
                        {
                            @foreach (var ta in emp.TicketAssignments)
                            {
                                <a asp-controller="Tickets" asp-action="Details" asp-route-id="@ta.TicketId" class="badge bg-secondary text-decoration-none me-1">
                                    #@ta.TicketId
                                </a>
                            }
                        }
                        else
                        {
                            <span class="text-muted fs-7">No tickets assigned</span>
                        }
                    </td>
                </tr>
            }
        </tbody>        </table>
    </div>
</div>