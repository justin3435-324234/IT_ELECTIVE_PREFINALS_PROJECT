@{
    ViewData["Title"] = "Reports Dashboard";
}
<div class="container mt-4"><h2 class="mb-3">Reports & Workload Analytics</h2><hr /><div class="row mb-4"><div class="col-md-4 mb-3"><div class="card bg-light shadow-sm border-0"><div class="card-body"><h6 class="card-subtitle mb-2 text-muted">Total System Tickets</h6><p class="card-text display-6 font-weight-bold mb-0">@ViewBag.TotalTickets</p></div></div></div><div class="col-md-4 mb-3"><div class="card bg-warning bg-opacity-10 border-warning shadow-sm"><div class="card-body"><h6 class="card-subtitle mb-2 text-warning">Unassigned Tickets</h6><p class="card-text display-6 font-weight-bold text-warning mb-0">@ViewBag.UnassignedTicketsCount</p></div></div></div><div class="col-md-4 mb-3"><div class="card bg-light shadow-sm border-0"><div class="card-body"><h6 class="card-subtitle mb-2 text-muted">Total Active Employees</h6><p class="card-text display-6 font-weight-bold mb-0">@ViewBag.TotalEmployees</p></div></div></div></div><div class="list-group shadow-sm"><a asp-action="Workload" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3"><div><h5 class="mb-1">Employee & Department Workload</h5><p class="mb-0 text-muted">View workload distribution, assigned tickets, and active status per employee.</p></div><span class="btn btn-sm btn-outline-primary">&rarr;</span></a><a asp-action="Unassigned" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3"><div><h5 class="mb-1">Unassigned Tickets Query</h5><p class="mb-0 text-muted">Review tickets currently waiting for an employee assignment.</p></div><span class="btn btn-sm btn-outline-warning">&rarr;</span></a><a asp-action="CategoryHierarchy" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3"><div><h5 class="mb-1">Category Hierarchy & Ticket Breakdown</h5><p class="mb-0 text-muted">View ticket totals and resolution status grouped by category.</p></div><span class="btn btn-sm btn-outline-info">&rarr;</span></a></div></div>B