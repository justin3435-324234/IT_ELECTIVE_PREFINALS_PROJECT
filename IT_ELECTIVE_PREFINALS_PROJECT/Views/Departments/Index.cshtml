@model IEnumerable<IT_ELECTIVE_PREFINALS_PROJECT.Models.Department>

<h2>Departments</h2>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Department Name</th>
            <th>Description</th>
            <th>Status</th>
            <th>Total Employees</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var dept in Model)
        {
            <tr>
                <td>@dept.Name</td>
                <td>@dept.Description</td>
                <td>@(dept.IsActive == 1 ? "Active" : "Inactive")</td>
                <td>@dept.Employees.Count</td>
            </tr>
        }
    </tbody>
</table>